{
  "name": "daodrops-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "set NODE_ENV=production && node dist/index.js",
    "dev": "set NODE_ENV=development && tsx watch index.ts",
    "test": "set NODE_ENV=development && tsx index.ts",
    "format": "prettier --write .",
    "docs": "jsdoc -c jsdoc.json",
    "docs:clean": "rm -rf docs && npm run docs",
    "seed:picks-import": "node dist/pickSeeder.js -i",
    "seed:picks-delete": "node dist/pickSeeder.js -d",
    "seed:picks-export": "node dist/pickSeeder.js -e",
    "seed:scores-import": "node dist/scoreSeeder.js -i",
    "seed:scores-delete": "node dist/scoreSeeder.js -d",
    "seed:posts-delete": "node dist/scoreSeeder.js -dp",
    "seed:scores-export-participants": "node dist/scoreSeeder.js -ep",
    "seed:scores-export-points": "node dist/scoreSeeder.js -evp"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "json2csv": "^5.0.7",
    "mongoose": "^8.19.2",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "web3-token": "^1.0.6"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^24.10.0",
    "docdash": "^2.0.2",
    "jsdoc": "^4.0.5",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
